Screen {
    overflow: hidden;
    background: $background;
    color: $foreground;
}

ToastRack {
    align: right top;
}

#topbar {
    height: 7;
    background: $surface;
    border-bottom: solid $primary;
}

#header-logo {
    width: 24;
    height: 5;
    margin: 1 1;
    offset: -1 0;
    color: $primary;
    text-align: center;
}

#header-meta {
    width: 1fr;
    height: 5;
    margin: 1 0;
    padding: 1 1;
}

#header-title {
    height: 2;
    text-style: bold;
}

#header-config {
    color: $secondary;
}

#workspace {
    height: 1fr;
}

#sidebar {
    width: 24;
    background: $surface;
    border-right: solid $primary;
    padding: 1 1;
}

#sidebar-items {
    height: auto;
    background: transparent;
}

#sidebar-items > ListItem {
    layout: horizontal;
    height: 1;
    padding: 0 1;
}

.nav-icon {
    width: 3;
    color: $secondary;
    content-align: left middle;
}

.nav-label {
    width: 1fr;
    content-align: left middle;
}

#sidebar-rail {
    display: none;
    height: 1fr;
    text-align: center;
    content-align: center top;
}

#content {
    height: 1fr;
}

#content > VerticalScroll,
#content > Vertical {
    padding: 1 2;
}

#dashboard {
    overflow-x: hidden;
    overflow-y: auto;
}

.section {
    color: $secondary;
    text-style: bold;
    margin-top: 1;
}

#config-status,
#paths {
    margin-bottom: 1;
}

#build-status,
#build-stage {
    text-style: bold;
}

#confirmation,
#build-error,
#results,
#build-events-scroll {
    border: round $primary;
    padding: 0 1;
    margin-top: 1;
}

#build-events-scroll {
    height: 1fr;
    min-height: 8;
}

#confirmation,
#build-error,
#results {
    display: none;
}

#build-error {
    color: $error;
}

#apps,
#build-jobs,
#patch-table,
#bundles-table,
#cache-table {
    width: 1fr;
    height: auto;
    margin-top: 1;
}

#dashboard #apps {
    height: 1fr;
    min-height: 8;
    background: $panel;
}

#app-actions,
#patch-actions,
#bundle-search-actions,
.modal-actions {
    height: 3;
    width: 1fr;
}

#bundle-source-actions {
    height: auto;
    width: 1fr;
}

#bundle-source-fields,
#bundle-source-buttons {
    height: 3;
    width: 1fr;
}

#bundle-source-buttons {
    margin-top: 1;
}

.modal-actions {
    align: center middle;
}

#app-actions Button,
#patch-actions Button,
#bundle-source-buttons Button,
.modal-actions Button {
    margin-right: 1;
}

#build-header {
    height: auto;
    align-vertical: middle;
}

#build-status-block {
    width: 1fr;
    height: auto;
}

#build-header Button {
    margin-left: 1;
}

#patch-app {
    width: 1fr;
    margin-right: 1;
}

#bundle-search-actions {
    height: auto;
    min-height: 3;
    width: 1fr;
}

#bundle-search {
    width: 1fr;
    margin-right: 1;
}

#bundle-source {
    width: 2fr;
    margin-right: 1;
}

#bundle-version {
    width: 1fr;
    margin-right: 1;
}

#bundles {
    overflow-x: hidden;
    overflow-y: auto;
}

#bundles-table {
    width: 1fr;
    height: 1fr;
    min-height: 12;
    margin-top: 1;
    overflow-x: auto;
}

#patch-list {
    height: 1fr;
    min-height: 10;
    margin-top: 1;
    border: round $primary;
}

#patch-list > PatchListItem,
.patch-item-body {
    height: auto;
}

#patch-list > PatchListItem {
    padding: 0 1;
}

.patch-item-row {
    height: 1;
}

.patch-checkbox {
    width: 4;
    height: 1;
}

.patch-summary {
    width: 1fr;
    height: 1;
}

.patch-option-summary {
    height: auto;
    margin-left: 4;
    color: $secondary;
}

.view-hint {
    color: $secondary;
    margin-bottom: 1;
}

#cache-status {
    margin-bottom: 1;
}

#cache-actions {
    height: 3;
}

#cache-actions Button {
    margin-right: 1;
}

#downloads {
    padding: 2 3;
    overflow-x: hidden;
    overflow-y: auto;
}

#download-actions {
    height: 5;
    width: 1fr;
    align-vertical: middle;
    margin-bottom: 1;
}

#download-version-actions {
    height: 4;
    width: 1fr;
    align-vertical: middle;
    margin-bottom: 1;
}

#download-buttons {
    height: 4;
    width: 1fr;
    align-vertical: middle;
    margin-bottom: 1;
}

#download-app {
    width: 2fr;
    margin-right: 2;
}

#download-arch,
#download-provider,
#download-version {
    width: 1fr;
    margin-right: 2;
}

#download-version-actions Button,
#download-buttons Button {
    margin-right: 2;
}

#download-destination {
    height: auto;
    min-height: 2;
    width: 1fr;
    padding: 0 1;
    margin: 1 0;
    color: $secondary;
    overflow-x: hidden;
}

#download-provider-order {
    margin: 1 0;
    color: $secondary;
}

#download-status,
#download-events-scroll {
    border: round $primary;
    padding: 0 1;
    margin-top: 1;
}

#download-events-scroll {
    height: 1fr;
    min-height: 8;
}

.bundle-narrow #bundle-source-fields,
.bundle-narrow #bundle-source-buttons,
.bundle-narrow #app-actions,
.bundle-narrow #patch-actions,
.bundle-narrow #download-actions,
.bundle-narrow #download-version-actions,
.bundle-narrow #download-buttons,
.bundle-narrow #download-library-actions {
    layout: vertical;
    height: auto;
}

.bundle-narrow #bundle-source,
.bundle-narrow #bundle-version {
    width: 1fr;
    margin-right: 0;
    margin-bottom: 1;
}

.bundle-narrow #bundle-source-buttons Button,
.bundle-narrow #app-actions Button,
.bundle-narrow #patch-actions Select,
.bundle-narrow #patch-actions Button,
.bundle-narrow #download-actions Select,
.bundle-narrow #download-version-actions Select,
.bundle-narrow #download-version-actions Button,
.bundle-narrow #download-buttons Button,
.bundle-narrow #download-library-actions Button {
    width: 1fr;
    margin-right: 0;
    margin-bottom: 1;
}

ContextMenuScreen,
PatchContextMenuScreen,
BuildContextMenuScreen,
CacheContextMenuScreen,
BundleContextMenuScreen,
DownloadContextMenuScreen {
    align: center middle;
    background: $background 25%;
}

CacheCleanScreen,
ConfirmScreen,
DownloadVersionsScreen,
LocalSourceScreen,
AppEditorScreen,
BundleAppsScreen,
PatchOptionsScreen {
    align: center middle;
    background: $background 70%;
}

#bundle-app-dialog {
    width: 92%;
    height: 90%;
    min-height: 12;
    max-height: 90%;
    padding: 1 1;
    background: $panel;
    border: round $primary;
}

#bundle-app-dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

#bundle-app-dialog-table {
    width: 1fr;
    height: 1fr;
    min-height: 5;
}

#bundle-app-dialog-actions {
    height: 3;
    margin-top: 1;
}

#bundle-app-dialog-actions Button {
    margin-right: 1;
}

ContextMenuScreen.at-pointer,
PatchContextMenuScreen.at-pointer,
BuildContextMenuScreen.at-pointer,
CacheContextMenuScreen.at-pointer,
BundleContextMenuScreen.at-pointer,
DownloadContextMenuScreen.at-pointer {
    align: left top;
}

#bundle-context-menu {
    width: 38;
    height: 6;
}

#bundle-context-title,
#bundle-context-options {
    width: 38;
    background: $surface;
}

#context-menu {
    width: 38;
    height: 8;
}

#context-title,
#context-options {
    width: 38;
    background: $surface;
}

#patch-context-menu {
    width: 42;
    height: 7;
}

#patch-context-title,
#patch-context-options {
    width: 42;
    background: $surface;
}

#build-context-menu {
    width: 38;
    height: 6;
}

#cache-context-menu {
    width: 38;
    height: 7;
}

#download-context-menu {
    width: 38;
    height: 8;
}

#build-context-title,
#build-context-options,
#cache-context-title,
#cache-context-options {
    width: 38;
    background: $surface;
}

#context-title,
#patch-context-title,
#build-context-title,
#cache-context-title,
#bundle-context-title {
    height: 3;
    padding: 0 1;
    border: round $primary;
    border-bottom: none;
    text-style: bold;
}

#context-options,
#patch-context-options,
#build-context-options,
#cache-context-options,
#bundle-context-options {
    border: round $primary;
    border-top: none;
}

#context-options {
    height: 5;
}

#patch-context-options {
    height: 4;
}

#build-context-options,
#bundle-context-options {
    height: 3;
}

#cache-context-options {
    height: 4;
}

#download-context-title {
    width: 38;
    height: 3;
    padding: 0 1;
    background: $surface;
    border: round $primary;
    border-bottom: none;
    text-style: bold;
}

#download-context-options {
    width: 38;
    height: 5;
    background: $surface;
    border: round $primary;
    border-top: none;
}

#cache-clean-dialog {
    width: 78;
    height: auto;
    max-height: 30;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#cache-clean-summary {
    margin: 1 0;
    color: $secondary;
}

#cache-clean-options {
    height: auto;
}

#cache-clean-options Checkbox {
    margin-bottom: 1;
}

#download-library {
    padding: 1 2;
    overflow-x: hidden;
    overflow-y: auto;
}

#download-library-destination {
    color: $secondary;
    margin-bottom: 1;
}

#download-library-table {
    width: 1fr;
    height: 1fr;
    min-height: 8;
    margin-top: 1;
}

#download-library-actions {
    height: auto;
    min-height: 3;
    margin-top: 1;
}

#download-library-actions Button {
    margin-right: 1;
}

#download-version-dialog {
    width: 66;
    height: auto;
    max-height: 24;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#download-version-dialog-app,
#download-version-dialog-hint {
    color: $secondary;
    margin-bottom: 1;
}

#download-version-choice {
    width: 1fr;
    margin: 1 0;
}

#confirm-dialog {
    width: 66;
    height: auto;
    max-height: 20;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#confirm-question {
    width: 1fr;
    margin-bottom: 1;
}

#app-editor {
    width: 72;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#app-editor Label {
    color: $secondary;
    margin-top: 1;
}

#app-editor .field-section {
    color: $secondary;
    text-style: bold;
}

#app-editor Input,
#app-editor Select,
#app-editor .modal-actions Button,
#source-picker-row {
    width: 1fr;
    height: auto;
}

#edit-source-dir {
    width: 1fr;
    min-height: 3;
    padding: 1;
    color: $secondary;
    background: $panel;
    content-align: left middle;
}

#source-picker-actions {
    width: 1fr;
    height: auto;
    margin-top: 1;
}

#source-picker-actions Button {
    width: auto;
    min-width: 16;
    margin-right: 1;
}

#local-source-dialog {
    width: 70;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#local-source-app,
#local-source-help {
    color: $secondary;
    margin-bottom: 1;
}

#local-source-error {
    color: $error;
    margin-bottom: 1;
}

#patch-options-editor Input,
#patch-options-editor Select,
#patch-options-editor .modal-actions Button {
    width: 1fr;
}

#patch-options-editor {
    width: 80;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#patch-options-editor Label {
    color: $secondary;
    margin-top: 1;
}

.patch-option-description {
    color: $secondary;
    height: auto;
    margin-bottom: 1;
}

#patch-option-error {
    color: $error;
    margin-top: 1;
}

.modal-title {
    text-style: bold;
    margin-bottom: 1;
}

#editor-error {
    color: $error;
    margin-top: 1;
}

#footer-bar {
    dock: bottom;
    height: 2;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $secondary;
}

.sidebar-collapsed #sidebar,
.compact-rail #sidebar {
    width: 7;
    padding: 1;
}

.sidebar-collapsed #sidebar-items,
.compact-rail #sidebar-items {
    display: none;
}

.sidebar-collapsed #sidebar-rail,
.compact-rail #sidebar-rail {
    display: block;
}

.compact-rail #content > VerticalScroll {
    padding: 1;
}

#splash {
    layer: overlay;
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: $background;
    color: $primary;
    content-align: center middle;
    text-align: center;
}
